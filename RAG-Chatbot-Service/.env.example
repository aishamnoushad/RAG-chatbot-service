# Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/rag-chat-db
DB_USERNAME=raguser
DB_PASSWORD=rag@123

# JPA Configuration
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

# API Configuration
API_KEY=your-secure-api-key-for-the-chat-service

# Rate Limiting Configuration
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Logging Configuration
LOG_LEVEL=INFO
SECURITY_LOG_LEVEL=WARN

# Server Configuration
SERVER_PORT=8080

# Docker Compose (Postgres container) variables
# These are used by compose.yaml. If you change credentials after the database was initialized,
# run: docker compose down -v  (to remove the data volume) and then: docker compose up -d
POSTGRES_DB=rag-chat-db
POSTGRES_USER=raguser
POSTGRES_PASSWORD=rag@123
POSTGRES_PORT=5432
