# Environment variables for RAG-Chatbot-Service (Docker Compose)

# --- Application ---
API_KEY=change-me-to-a-secure-random-string
RATE_LIMIT_REQUESTS_PER_MINUTE=60
SERVER_PORT=8087
APP_PORT=8087

# Disable Spring Boot Compose integration (handled by Docker Compose)
ENABLE_DOCKER_COMPOSE=false
# Control Flyway migrations (true/false)
FLYWAY_ENABLED=true

# --- Database (Postgres) ---
POSTGRES_DB=rag-chat-db
POSTGRES_USER=raguser
POSTGRES_PASSWORD=rag@123
POSTGRES_PORT=5432

# --- Optional: pgAdmin ---
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin123
PGADMIN_PORT=5050
